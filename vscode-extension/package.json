{
  "name": "appscan-salesforce",
  "displayName": "AppScan - Salesforce Security & Code Analysis",
  "description": "On-premises Salesforce code analysis, security linting, quality gates, and git baseline comparison for VS Code",
  "version": "0.2.0",
  "publisher": "srkt",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Testing"
  ],
  "keywords": [
    "salesforce",
    "apex",
    "security",
    "pmd",
    "quality-gate",
    "baseline"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:apex",
    "onCommand:appscan.scanWorkspace",
    "onCommand:appscan.scanWithCustomBaseline",
    "onCommand:appscan.scanFolder",
    "onCommand:appscan.showReport",
    "onCommand:appscan.clearFindings",
    "onCommand:appscan.setToken"
  ],
  "contributes": {
    "commands": [
      {
        "command": "appscan.scanWorkspace",
        "title": "AppScan: Scan Workspace against Baseline",
        "icon": "$(shield)"
      },
      {
        "command": "appscan.scanWithCustomBaseline",
        "title": "AppScan: Scan with Custom Baseline Branch/Tag...",
        "icon": "$(git-compare)"
      },
      {
        "command": "appscan.scanFolder",
        "title": "AppScan: Scan Selected Folder",
        "icon": "$(folder)"
      },
      {
        "command": "appscan.showReport",
        "title": "AppScan: Show Quality Gate & Findings Dashboard",
        "icon": "$(report)"
      },
      {
        "command": "appscan.clearFindings",
        "title": "AppScan: Clear Diagnostic Findings",
        "icon": "$(clear-all)"
      },
      {
        "command": "appscan.setToken",
        "title": "AppScan: Set Server API Token"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "appscan.scanFolder",
          "group": "7_modification",
          "when": "explorerResourceIsFolder"
        }
      ],
      "commandPalette": [
        {
          "command": "appscan.scanWorkspace"
        },
        {
          "command": "appscan.scanWithCustomBaseline"
        },
        {
          "command": "appscan.scanFolder"
        },
        {
          "command": "appscan.showReport"
        },
        {
          "command": "appscan.clearFindings"
        }
      ],
      "editor/title": [
        {
          "command": "appscan.scanWorkspace",
          "group": "navigation",
          "when": "resourceExtname =~ /\\.(cls|trigger|page|xml)$/"
        }
      ]
    },
    "configuration": {
      "title": "AppScan",
      "properties": {
        "appscan.serverUrl": {
          "type": "string",
          "default": "http://192.168.50.109:8089",
          "description": "URL of the AppScan backend server"
        },
        "appscan.username": {
          "type": "string",
          "default": "admin",
          "description": "AppScan server username"
        },
        "appscan.password": {
          "type": "string",
          "default": "",
          "description": "Legacy password setting. Prefer AppScan: Set Server API Token (VS Code SecretStorage)."
        },
        "appscan.defaultBaseline": {
          "type": "string",
          "default": "main",
          "description": "Default Git branch or commit to use as baseline"
        },
        "appscan.apiVersion": {
          "type": "string",
          "default": "64.0",
          "description": "Target Salesforce Metadata API version"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run sync-python && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "sync-python": "node scripts/sync-python.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  }
}
